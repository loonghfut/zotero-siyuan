pref-title = 思源连接
pref-cliPath = siyuan 命令行路径
pref-workspace = 工作空间
pref-notebook = 笔记本
pref-notebook-auto = 自动（第一个可用的笔记本）
pref-notebook-missing = %s（在思源里没找到）
pref-test = 测试连接
pref-testing = 正在测试…
pref-ok = 连接成功，笔记本
pref-http-only = 通过思源 HTTP 接口连接（命令行不可用）
pref-selftest = 运行端到端自检
pref-checkpictures = 检查框选图片
pref-selftesting = 正在运行自检…
pref-selftest-ok = 自检通过，报告位于
pref-selftest-failed = 自检失败
pref-rescan = 重新扫描已发送的注释
pref-rescanning = 正在扫描思源…
pref-rescanned = 已发送的注释
pref-hint = 命令行路径留空会自动查找；工作空间留空则使用 siyuan 命令行当前的工作空间；笔记本留空则使用第一个笔记本。

pref-destination-title = 发送到
pref-destination = 目标位置
pref-destination-daily = 今天的日记
pref-destination-document = 指定文档
pref-destination-item = 每篇文献一个文档
pref-target-document = 文档标题或 ID
pref-item-doc-name = 新文档的标题（可用模板变量）
pref-item-doc-path = 放在哪个路径下（例如 /读书）
pref-sent-action = 已经发过的注释
pref-sent-action-ask = 每次问我
pref-sent-action-skip = 跳过
pref-sent-action-send = 再发一条
pref-sent-action-replace = 替换上次
pref-destination-hint = 默认写到今天的日记。选「指定文档」时填文档标题或块 ID；选「每篇文献一个文档」时，会在所选笔记本里为这篇文献建一个文档，并用 custom-zotero-item-key 记住它，下次直接写进去。这个目标可以有自己的模板：在下面的「发送模板」里把「模板用途」切到「每篇文献一个文档」。保存模板时会把这里的目标位置一起存下来，套用模板时一并恢复。

pref-auto-title = 自动发送与待发队列
pref-auto-send = 新建注释时自动发送
pref-auto-hint = 默认关闭。打开后，只有同时符合下面全部条件的注释才会自动发送；某个条件留空或全不勾选，表示这一项不限。
pref-auto-colors = 颜色
pref-auto-color-yellow = 黄色
pref-auto-color-red = 红色
pref-auto-color-green = 绿色
pref-auto-color-blue = 蓝色
pref-auto-color-purple = 紫色
pref-auto-color-magenta = 品红
pref-auto-color-orange = 橙色
pref-auto-color-gray = 灰色
pref-auto-tags = 标签（逗号分隔）
pref-auto-types = 注释类型
pref-auto-type-highlight = 高亮
pref-auto-type-underline = 下划线
pref-auto-type-note = 笔记
pref-auto-type-text = 文字
pref-auto-type-image = 框选
pref-auto-item-types = 条目分类（如 journalArticle、book，逗号分隔）
pref-auto-filter-hint = 标签匹配注释上的标签；条目分类匹配文献条目的类型。所有条件都为空时，所有新注释都会被发送。
pref-auto-queue-retry = 立即重试待发队列
pref-auto-queue-clear = 清空待发队列
pref-auto-queue-status = 待发队列：%d 条
pref-auto-queue-empty = 待发队列是空的
pref-auto-queue-retrying = 正在重试…
pref-auto-queue-cleared = 待发队列已清空
pref-auto-queue-left = 还有 %d 条没能发送，稍后会自动重试
pref-auto-queue-sent = 补发了 %d 条
pref-auto-queue-hint = 思源没启动或写入失败时，自动发送的注释会进入待发队列；下次启动、或任意一次发送成功后自动重试。上面的自动发送开关关闭时，队列会暂停。

pref-picture-title = 框选图片
pref-image-compress = 发送前压缩图片
pref-image-quality = 压缩质量
pref-image-saved = 已保存
pref-picture-hint = 框选注释的截图是页面截图，带一条其实全不透明的透明通道，体积是需要的几倍。压缩后转成 JPEG 再发出去，通常只剩两成左右；压缩后反而更大时保留原图。质量可以自己调：数字越小越小越糙，100 最大最清楚。

pref-template-title = 发送模板
pref-template-scope = 模板用途
pref-template-scope-note = 通用模板（日记 / 指定文档）
pref-template-scope-item = 每篇文献一个文档
pref-template-scope-hint = 「每篇文献一个文档」可以单独用一份模板，适合写成文献笔记。这里的编辑框留空时沿用上面的通用模板；变量和写法完全一样。
pref-template-item-inherit = 留空，将沿用通用模板
pref-template = 模板
pref-template-preset = 模板预设
pref-template-preset-apply = 套用
pref-preset-applied = 已套用模板
pref-template-reset = 恢复默认
pref-template-saved = 已保存
pref-template-reset-done = 已恢复默认模板
pref-template-item-reset-done = 已改为沿用通用模板
pref-templates = 我的模板
pref-templates-save = 保存
pref-templates-load = 套用
pref-templates-delete = 删除
pref-templates-hint = 调好的模板可以留着：起个名字点「保存」，以后在下拉列表里选中再点「套用」就换回来了。名字留空、但列表里选中了一个时，点「保存」是更新选中的那个。删除要按两次，按第一次只是问一句。
pref-template-save-name = 模板名字…
pref-templates-empty = 还没有保存的模板
pref-template-save-new = 已保存模板
pref-template-save-updated = 已更新模板
pref-template-save-empty = 模板是空的，没什么可保存的
pref-template-save-limit = 保存的模板太多了，先删掉一个
pref-template-need-name = 先给模板起个名字
pref-template-need-pick = 先在下拉列表里选一个模板
pref-template-loaded = 已套用模板
pref-template-delete-ask = 再按一次「删除」就会删掉
pref-template-deleted = 已删除模板
pref-template-unknown = 模板里有未知变量
pref-preview = 预览
pref-variables = 可用变量
pref-variables-filter = 按名字或说明过滤…
pref-variables-only-used = 只看已用
pref-variables-empty = 没有匹配的变量。
pref-variables-hint = 点一个变量名就能把它插到模板的光标处；已经用过的变量会加粗。引用块变量会自动独占一行。
pref-insert-hint = 点击插入到光标处
pref-inserted = 已插入
pref-conditionals = 条件
pref-conditionals-if = 插入条件块
pref-conditionals-else = 插入 else
pref-conditionals-end = 插入结尾
pref-conditionals-hint = 选中一段文字再点「插入条件块」，就会把它包进 {"{{"}#if 变量{"}}"}…{"{{"}/if{"}}"} 里；没有选区就插入一个空的条件块，光标停在两个标签之间。
pref-template-hint = 模板就是 Markdown。用 {"{{"}变量{"}}"} 插入内容，用 {"{{"}#if 变量{"}}"}…{"{{"}/if{"}}"} 只在变量不为空时保留这一段，中间的 {"{{"}else{"}}"} 是它的另一分支。预览用的是你库里真实的一条注释。

pref-checkingpictures = 正在查找框选注释…
pref-pictures-found = 框选注释
pref-pictures-missing = 找不到截图
pref-pictures-none = 库里没有框选注释。
