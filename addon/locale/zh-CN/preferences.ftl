pref-workspace = 工作空间
pref-notebook = 笔记本
pref-test = 测试连接
pref-testing = 正在测试…
pref-ok = 连接成功，笔记本
pref-http-only = 通过思源 HTTP 接口连接（命令行不可用）
pref-selftest = 运行端到端自检
pref-checkpictures = 检查框选图片
pref-selftesting = 正在运行自检…
pref-selftest-ok = 自检通过，报告位于
pref-selftest-failed = 自检失败
pref-rescan = 重新扫描已发送的注释
pref-rescanning = 正在扫描思源…
pref-rescanned = 已发送的注释
pref-hint = 命令行路径留空会自动查找；工作空间留空则使用 siyuan 命令行当前的工作空间；笔记本留空则使用第一个笔记本。

pref-picture-title = 框选图片
pref-image-compress = 发送前压缩图片
pref-image-quality = 压缩质量
pref-image-saved = 已保存
pref-picture-hint = 框选注释的截图是页面截图，带一条其实全不透明的透明通道，体积是需要的几倍。压缩后转成 JPEG 再发出去，通常只剩两成左右；压缩后反而更大时保留原图。质量可以自己调：数字越小越小越糙，100 最大最清楚。

pref-template-title = 发送模板
pref-template = 模板
pref-template-preset = 模板预设
pref-template-preset-apply = 套用
pref-preset-applied = 已套用模板
pref-template-reset = 恢复默认
pref-template-saved = 已保存
pref-template-reset-done = 已恢复默认模板
pref-templates = 我的模板
pref-templates-save = 保存
pref-templates-load = 套用
pref-templates-delete = 删除
pref-templates-hint = 调好的模板可以留着：起个名字点「保存」，以后在下拉列表里选中再点「套用」就换回来了。名字留空、但列表里选中了一个时，点「保存」是更新选中的那个。删除要按两次，按第一次只是问一句。
pref-template-save-name = 模板名字…
pref-templates-empty = 还没有保存的模板
pref-template-save-new = 已保存模板
pref-template-save-updated = 已更新模板
pref-template-save-empty = 模板是空的，没什么可保存的
pref-template-save-limit = 保存的模板太多了，先删掉一个
pref-template-need-name = 先给模板起个名字
pref-template-need-pick = 先在下拉列表里选一个模板
pref-template-loaded = 已套用模板
pref-template-delete-ask = 再按一次「删除」就会删掉
pref-template-deleted = 已删除模板
pref-template-unknown = 模板里有未知变量
pref-preview = 预览
pref-variables = 可用变量
pref-variables-filter = 按名字或说明过滤…
pref-variables-only-used = 只看已用
pref-variables-empty = 没有匹配的变量。
pref-variables-hint = 点一个变量名就能把它插到模板的光标处；已经用过的变量会加粗。引用块变量会自动独占一行。
pref-insert-hint = 点击插入到光标处
pref-inserted = 已插入
pref-conditionals = 条件
pref-conditionals-if = 插入条件块
pref-conditionals-else = 插入 else
pref-conditionals-end = 插入结尾
pref-conditionals-hint = 选中一段文字再点「插入条件块」，就会把它包进 {"{{"}#if 变量{"}}"}…{"{{"}/if{"}}"} 里；没有选区就插入一个空的条件块，光标停在两个标签之间。
pref-template-hint = 模板就是 Markdown。用 {"{{"}变量{"}}"} 插入内容，用 {"{{"}#if 变量{"}}"}…{"{{"}/if{"}}"} 只在变量不为空时保留这一段，中间的 {"{{"}else{"}}"} 是它的另一分支。预览用的是你库里真实的一条注释。

pref-checkingpictures = 正在查找框选注释…
pref-pictures-found = 框选注释
pref-pictures-missing = 找不到截图
pref-pictures-none = 库里没有框选注释。
