{
  "manifest_version": 2,
  "name": "Zotero → SiYuan",
  "version": "0.1.0",
  "description": "Send a PDF reader annotation and its comment straight to your SiYuan daily note.",
  "author": "steve",
  "homepage_url": "https://github.com/steve/zotero-siyuan",
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png"
  },
  "applications": {
    "zotero": {
      "id": "zotero-siyuan@example.com",
      "strict_min_version": "7.0",
      "strict_max_version": "10.0.*"
    }
  }
}
