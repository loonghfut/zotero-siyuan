# Used by `npm start` (zotero-plugin serve) to launch your Zotero with the plugin
# loaded from source. Adjust the paths to your machine.

# Path to the Zotero executable
ZOTERO_PLUGIN_ZOTERO_PATH=C:\Program Files\Zotero\zotero.exe

# Extra command line arguments passed to Zotero
ZOTERO_PLUGIN_START_ARGS=-ZoteroDebugText -jsconsole

# A separate profile for development (created on first run)
ZOTERO_PLUGIN_PROFILE=dev
